# Copy to .env and `set -a; source .env; set +a` before running a part.
LLM_MODE=mock                          # mock = offline, deterministic; live = call the model
LLM_BASE_URL=https://litellm.tikalk.dev # any OpenAI-compatible endpoint (LiteLLM, vLLM, OpenAI...)
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LAB_USER=tester                        # Part 3: who logs in (hagzag, tester, ops-admin)
